rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules, then Publish.
// The Firebase console itself bypasses these rules, so staff manage
// products and order status there.
service cloud.firestore {
  match /databases/{database}/documents {

    // Anyone may browse, signed in or not.
    match /products/{productId} {
      allow read: if true;
      allow write: if false; // console only
    }

    match /orders/{orderId} {
      allow read: if request.auth != null
        && resource.data.user_id == request.auth.uid;

      // Customers can only create their own pending order. Prices/total in
      // the order are written by the client, so staff MUST re-check them
      // against the product prices before confirming. See README.
      // Lengths must match lib/data/order_repository.dart.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['user_id', 'status', 'items', 'total', 'phone',
              'delivery_method', 'address', 'note', 'created_at'])
        && request.resource.data.keys().hasAll(
             ['user_id', 'status', 'items', 'total', 'phone',
              'delivery_method', 'address', 'note', 'created_at'])
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 20
        && request.resource.data.total is int
        && request.resource.data.total >= 0
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 20
        && request.resource.data.delivery_method in ['delivery', 'pickup']
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 500
        && (request.resource.data.delivery_method == 'pickup'
            || request.resource.data.address.size() > 0)
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.created_at == request.time;

      // A customer may cancel their own order while it is still pending,
      // and change nothing else.
      allow update: if request.auth != null
        && resource.data.user_id == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status']);

      allow delete: if false; // console only
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
