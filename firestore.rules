rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules, then Publish.
// The Firebase console itself bypasses these rules, so staff manage
// products and order status there.
service cloud.firestore {
  match /databases/{database}/documents {

    match /products/{productId} {
      allow read: if request.auth != null;
      allow write: if false; // console only
    }

    match /orders/{orderId} {
      allow read: if request.auth != null
        && resource.data.user_id == request.auth.uid;

      // Customers can only create their own pending order. Prices/total in
      // the order are written by the client, so staff MUST re-check them
      // against the product prices before confirming. See README.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(
             ['user_id', 'status', 'items', 'total_cents', 'created_at'])
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 20
        && request.resource.data.total_cents is int
        && request.resource.data.total_cents >= 0
        && request.resource.data.created_at == request.time;

      allow update, delete: if false; // console only
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
