<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ splash icon. With no icon background the system draws this
     at 288dp and shows a 192dp circle of it; a 72dp inset leaves the logo at
     144dp, whole inside the circle and matching launch_background.xml. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/splash_logo"
    android:inset="72dp" />
